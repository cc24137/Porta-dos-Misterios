  m_Script: {fileID: 11500000, guid: 5402e07e41a603742bb995e649edae25, type: 3}
  m_Name: DiarioRasgado02
  m_EditorClassIdentifier: Assembly-CSharp::NotaData
  nomeItem: "DI\xE1rio Rasgado"
  icone: {fileID: 21300000, guid: 43b1ecd54176145a2b4f00ca71bac298, type: 3}
  descricao: "Um di\xE1rio com apenas algumas p\xE1ginas, aparentemente rasgado."
  prefabNoChao: {fileID: 5660429781868002973, guid: a677c91428c7330418e528d2fdb0ee50, type: 3}
  paginasDaNota:
  - "\"13/12/1452\nFinalmente avancei para a sequ\xEAncia 8 - Mestre de Truques!\""
  - "\"O Sr. Gray disse que eu consegui avan\xE7ar de sequ\xEAncia bem r\xE1pido,
    mas acho que s\xF3 consegui por causa dele... Ainda por cima, achei que fosse
    perder o controle quando tomei a po\xE7\xE3o-\""
  - "\"Enfim, essa sequ\xEAncia me permite conjurar v\xE1rios pequenos truques, eles
    n\xE3o s\xE3o grande coisa nem s\xE3o muito amea\xE7adores mas podem fazer um
    showzinho.\""
  - '"Para citar um exemplo de truque, eu ando treinando o Flash [F], que sem querer
    usei para deixar o Sr. Dorian cego por uns momentos sem querer..."'
  - "(Pequenos truques? Talvez o Flash [F] seja \xFAtil para desviar desses guardinhas...)"
